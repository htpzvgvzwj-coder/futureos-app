{
  "name": "ocbc-futureos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint app --max-warnings=0",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:integration": "node --env-file=.env --test \"tests/integration/**/*.test.mjs\"",
    "smoke:change-ledger": "node --env-file=.env _smoke_change_ledger.mjs",
    "smoke:future-field": "node --env-file=.env _smoke_future_field.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "seed:demo": "node --env-file=.env scripts/seed-demo.mjs",
    "db:seed-demo": "node --env-file=.env scripts/seed-demo-user.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "npm i -D @playwright/test && playwright install chromium",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:seed": "node --env-file=.env scripts/seed-e2e-user.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "bcryptjs": "^3.0.3",
    "framer-motion": "12.41.0",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "10.5.0",
    "eslint-config-next": "16.2.9",
    "playwright-core": "1.57.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
